# VentureTwin Environment Configuration

# LLM Execution Mode: mock | real | record | replay
# - mock: Fast, deterministic offline run with synthetic agent assumptions
# - real: Live calls to the configured LLM provider
# - record: Live calls recorded into tests/cassettes/ for reproducible replay
# - replay: Exact offline replay from committed cassettes without network calls
LLM_MODE=mock

# LLM Provider: gemini | cerebras | openai | anthropic | openai_compatible
LLM_PROVIDER=gemini

# LLM Model ID: Select an active, available model identifier
# Cerebras: qwen-3.8-27b, gpt-oss-120b, llama3.1-8b, llama3.1-70b
# Gemini: gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-2.5-flash
# OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL=gemini-3.1-flash-lite

# API Keys (Do not commit real keys to version control!)
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Maximum concurrent LLM requests (avoids provider rate limits and 429 quota errors)
LLM_MAX_CONCURRENCY=2

# CORS Allowed Origins (comma-separated list for local frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://localhost:3000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# ============================================================
# Executive Agent Data Integrations (Test & Developer Mode)
# ============================================================

# CFO — Financial Data
# 1. Stripe (Test Mode): Retrieve charges, invoices, subscriptions & customers
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here

# 2. QuickBooks (Sandbox Company): Retrieve P&L, balance sheets, accounts & expenses
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REFRESH_TOKEN=your_quickbooks_sandbox_refresh_token
QUICKBOOKS_COMPANY_ID=your_quickbooks_sandbox_realm_id

# Growth — Marketing & Sales Data
# 3. HubSpot (Developer Test Account): Contacts, companies, pipelines & deals
HUBSPOT_ACCESS_TOKEN=pat-na1-your_hubspot_private_app_token

# 4. Google Analytics 4 (Measurement Protocol & Data API): Sessions & events
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_measurement_protocol_secret
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# CTO — Engineering & Infrastructure
# 5. GitHub: Commits, PRs, issues, releases, and workflow velocity
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=owner/repository-name

# 6. AWS CloudWatch (Custom Metric Sandbox): CPU, memory, API latency & error metrics
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Customer Success — Customer & Support Data
# 7. Intercom (Developer Workspace): Contacts, conversations & statistics
INTERCOM_ACCESS_TOKEN=dgtp_your_intercom_developer_token

# 8. Zendesk (Sandbox): Support tickets, resolution times & SLA metrics
ZENDESK_SUBDOMAIN=your_company_sandbox
ZENDESK_EMAIL=admin@yourcompany.com
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# Product — Product Analytics & Roadmap
# 9. PostHog (Dedicated Cloud / Self-hosted): Events, feature adoption & sessions
POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=app.posthog.com

# 10. Linear: Issues, roadmap projects, cycles & feature initiatives
LINEAR_API_KEY=lin_api_your_linear_personal_api_key

# Skeptic — External Market Intelligence
# 11. Firecrawl: Real-time public competitor website & pricing scraping
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# 12. Tavily: Evidence-backed web search & competitive industry benchmarks
TAVILY_API_KEY=tvly-your_tavily_search_api_key
